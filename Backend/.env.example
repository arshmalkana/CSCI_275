# AH Punjab Reporting — Backend Environment Variables
# Copy this file to .env and fill in every value before running.
# All values marked REQUIRED must be set; missing values in production cause the app to crash on boot.

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=production          # 'production' | 'development'
LOG_LEVEL=info               # 'debug' | 'info' | 'warn' | 'error'

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ahpunjab_db
DB_USER=ahpunjab
DB_PASSWORD=CHANGE_ME        # REQUIRED in production

# ── JWT Secrets (REQUIRED) ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_CHARS_HEX
JWT_REFRESH_SECRET=CHANGE_ME_64_CHARS_HEX

# ── Cookie Secret (REQUIRED) ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=CHANGE_ME_32_CHARS_HEX

# ── CORS (REQUIRED in production) ─────────────────────────────────────────────
# Comma-separated list of allowed origins (e.g. https://app.ahpunjab.gov.in)
CORS_ORIGINS=https://app.ahpunjab.gov.in

# ── WebAuthn / Passkeys (REQUIRED for passkey login) ─────────────────────────
RP_ID=localhost               # In production: your domain e.g. ahpunjab.gov.in
RP_ORIGIN=http://localhost:3000  # In production: https://app.ahpunjab.gov.in

# ── Web Push / VAPID (REQUIRED for push notifications) ────────────────────────
# Generate with: node Backend/scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:admin@ahpunjab.gov.in

# ── Email / SMTP (REQUIRED for forgot-password flow) ─────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false            # true for port 465, false for 587
SMTP_USER=no-reply@ahpunjab.gov.in
SMTP_PASS=CHANGE_ME
SMTP_FROM="AH Punjab <no-reply@ahpunjab.gov.in>"

# ── Frontend (used to build password-reset links) ─────────────────────────────
FRONTEND_ORIGIN=https://app.ahpunjab.gov.in
