# AH Punjab Reporting — Backend Environment Variables
# Copy this file to .env and fill in every value before running.
# Values marked REQUIRED crash the server on boot if missing in production.
# Values marked FEATURE degrade gracefully (feature disabled, server still starts).

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=production          # 'production' | 'development'
LOG_LEVEL=info               # 'debug' | 'info' | 'warn' | 'error'

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# In Docker: DB_HOST=postgres (service name). On bare metal: DB_HOST=localhost
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ahpunjab_db
DB_USER=ahpunjab
DB_PASSWORD=CHANGE_ME        # REQUIRED — crashes on boot if unset in production

# ── JWT Secrets (REQUIRED) ────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_64_BYTE_HEX
JWT_REFRESH_SECRET=CHANGE_ME_64_BYTE_HEX

# ── Cookie Secret (REQUIRED) ──────────────────────────────────────────────────
# Generate: openssl rand -hex 32
COOKIE_SECRET=CHANGE_ME_32_BYTE_HEX

# ── CORS (REQUIRED in production) ─────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=https://ahdp.in

# ── WebAuthn / Passkeys ────────────────────────────────────────────────────────
# Must match your production domain exactly — passkeys silently fail if wrong.
RP_ID=ahdp.in                # just the bare domain, no https://
RP_ORIGIN=https://ahdp.in   # full origin with scheme
RP_NAME=AH Punjab Reporting  # display name shown during passkey registration

# ── Web Push / VAPID (FEATURE — push notifications) ───────────────────────────
# Generate: node Backend/scripts/generate-vapid-keys.js
# If unset, push notifications are disabled (warning logged, no crash).
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:admin@ahdp.in

# ── Email / Resend (FEATURE — forgot-password flow) ───────────────────────────
# Get from: https://resend.com/api-keys
# Sending domain (EMAIL_FROM domain) must be DNS-verified in Resend before
# emails deliver. See: https://resend.com/domains
# In development, if RESEND_API_KEY is unset emails are logged to console only.
RESEND_API_KEY=re_YOUR_API_KEY_HERE
EMAIL_FROM=AH Punjab <noreply@ahdp.in>

# ── Frontend origin (used to build password-reset links) ──────────────────────
FRONTEND_ORIGIN=https://ahdp.in
